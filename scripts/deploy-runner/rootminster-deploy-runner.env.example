# Copy to /etc/rootminster-deploy-runner.env and chmod 600.
# Generate the secret with: openssl rand -hex 32
DEPLOY_RUNNER_SECRET=
# Absolute path of your existing update script. It must be executable.
DEPLOY_RUNNER_SCRIPT=/opt/rootminster/update.sh
# DEPLOY_RUNNER_WORKDIR=/opt/rootminster
# The Docker bridge address: reachable from containers, not from the internet.
DEPLOY_RUNNER_BIND=172.17.0.1
DEPLOY_RUNNER_PORT=9787
DEPLOY_RUNNER_TIMEOUT=1800
# Set to 1 to show the last lines of a failed run in Discord. Script output can
# contain secrets, so only turn this on if your script does not print any.
DEPLOY_RUNNER_SHARE_LOG=0
