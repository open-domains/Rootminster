NODE_ENV=production
INITIAL_SETUP_KEY=replace-with-a-long-random-one-time-key
APP_URL=https://open-domains.com
APP_HOST=open-domains.com
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=20
SESSION_DAYS=30
# Generate both with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
MODULE_ENCRYPTION_KEY=
# Optional dedicated recovery key. When omitted, backups use MODULE_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
# Enable this when the request path is Cloudflare -> Traefik -> Rootminster.
# Rootminster will trust only private/loopback proxy peers and Cloudflare's
# published address ranges when resolving request.ip.
TRUST_CLOUDFLARE_PROXY=true
# Advanced override: comma-separated trusted proxy IPs/CIDRs.
TRUST_PROXY_CIDRS=
# Legacy hop-count setting for other proxy layouts. Prefer CIDRs because a
# hop count cannot validate that the immediate peer is really your proxy.
TRUST_PROXY_HOPS=1

# pgAdmin is exposed through Traefik at https://fishfinger.open-domains.com.
# Use a dedicated admin mailbox and a strong unique password.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password

# Optional modules are configured in Admin > Module Settings. The variables
# below are migration-only fallbacks for existing installations. Import them
# once from that page, confirm the modules work, then remove them from runtime.

# Legacy email fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Open Domains <no-reply@example.com>
CONTACT_EMAIL=hello@example.com

# Legacy Cloudflare DNS and Turnstile fallback
CLOUDFLARE_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Legacy Stripe donations fallback
DONATIONS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Legacy Google sign-in fallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy GitHub sign-in fallback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Legacy Discord interactions bot fallback
DISCORD_BOT_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Optional: register commands instantly in one development/test server
DISCORD_GUILD_ID=

# Legacy automated safety screening fallback. The optional provider receives request metadata
# by POST; Rootminster never fetches the submitted preview URL itself.
SAFETY_SCREENING_ENABLED=true
SAFETY_REPUTATION_API_URL=
SAFETY_REPUTATION_API_TOKEN=
SAFETY_REPUTATION_TIMEOUT_MS=4000

# Legacy remote MCP server fallback
MCP_ENABLED=true

# Legacy Umami fallback
UMAMI_URL=
UMAMI_API_CLIENT_ENDPOINT=
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=

# Legacy Hostinger Docker Manager fallback
HOSTINGER_API_KEY=
HOSTINGER_VIRTUAL_MACHINE_ID=
# Optional comma-separated names in addition to the built-in OpenDomains/Rootminster protection
HOSTINGER_PROTECTED_DOCKER_PROJECTS=

# Legacy GitHub migration source fallback
GITHUB_REGISTRY_URL=https://raw.githubusercontent.com/open-domains/raw/refs/heads/main/scripts/raw/index.json

# Traefik overlay
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
