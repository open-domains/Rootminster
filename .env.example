NODE_ENV=production
INITIAL_SETUP_KEY=replace-with-a-long-random-one-time-key
APP_URL=https://manage.example.com
APP_HOST=manage.example.com
APP_PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_POOL_SIZE=20
SESSION_DAYS=30

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Open Domains <no-reply@example.com>
CONTACT_EMAIL=hello@example.com

# Cloudflare DNS and Turnstile
CLOUDFLARE_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe donations
DONATIONS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Discord interactions bot
DISCORD_BOT_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Optional: register commands instantly in one development/test server
DISCORD_GUILD_ID=

# Automated safety screening. The optional provider receives request metadata
# by POST; Rootminster never fetches the submitted preview URL itself.
SAFETY_SCREENING_ENABLED=true
SAFETY_REPUTATION_API_URL=
SAFETY_REPUTATION_API_TOKEN=
SAFETY_REPUTATION_TIMEOUT_MS=4000

# Remote MCP server for ChatGPT and Claude
MCP_ENABLED=true

# Optional Umami module
UMAMI_URL=
UMAMI_API_CLIENT_ENDPOINT=
UMAMI_API_CLIENT_USER_ID=
UMAMI_API_CLIENT_SECRET=

# Optional GitHub migration source
GITHUB_REGISTRY_URL=https://raw.githubusercontent.com/open-domains/register/main/domains.json

# Traefik overlay
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
